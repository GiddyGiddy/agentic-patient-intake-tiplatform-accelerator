FRONTEND_PORT=3000
BACKEND_PORT=8000

# Gesundheits-ID / IAM (gematik) - lokal: Mock-ID-Dienst
OIDC_ISSUER=http://mock-id-dienst:8081
OIDC_JWKS_URL=http://mock-id-dienst:8081/jwks
OIDC_AUDIENCE=patient-intake
# Nur für lokale Entwicklung: Token-Validierung deaktivieren
AUTH_DISABLED=false

# KIS (ISiK FHIR)
FHIR_BASE_URL=http://mock-kis-fhir:8080/fhir
# ePA FHIR API. Dev: same HAPI mock. Prod: URL of the TI gateway/Konnektor in front of the ePA
EPA_BASE_URL=http://mock-kis-fhir:8080/fhir

# KIM-Clientmodul (SMTP)
KIM_SMTP_HOST=mock-kim-cm
KIM_SMTP_PORT=2525
KIM_SENDER=intake@praxis.kim.test
KIM_RECIPIENT=arzt@praxis.kim.test

# LLM (Ollama); leer = regelbasierter Fallback
LLM_BASE_URL=http://llm:11434
LLM_MODEL=llama3.2:3b

# Backend: Sitzung, Einwilligung, Schutz
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_S=3600
CONSENT_TTL_S=3600
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MIN=30
# Audit-Log (JSON-Zeilen, pseudonymisiert); leer = nur stdout
AUDIT_LOG_FILE=

# PostgreSQL (single persistent store)
POSTGRES_USER=intake
POSTGRES_PASSWORD=intake
POSTGRES_DB=intake
DATABASE_URL=postgresql+psycopg://intake:intake@postgres:5432/intake
# KIM outbox retry
KIM_RETRY_INTERVAL_S=60
KIM_MAX_ATTEMPTS=10

# Mock TI gateway (simulated SMC-B). Prod: URL of the real gateway/Konnektor
TELEMATIK_ID=1-1.2.3.4.5.KlinikKoeln
