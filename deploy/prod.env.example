# Copy to /etc/intake/prod.env on the server (chmod 600, owner = deploy user). NEVER commit the filled-in file.

# --- PostgreSQL (also used by the backend) ---
POSTGRES_USER=intake
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=intake
DATABASE_URL=postgresql+psycopg://intake:CHANGE_ME_LONG_RANDOM@postgres:5432/intake

# --- Gesundheits-ID / IAM (real gematik IdP / Sektoraler IdP) ---
OIDC_ISSUER=https://idp.klinik.local
OIDC_JWKS_URL=https://idp.klinik.local/jwks
OIDC_AUDIENCE=patient-intake
AUTH_DISABLED=false

# --- TI: KIS/ePA only via the real TI gateway / Konnektor ---
FHIR_BASE_URL=https://ti-gateway.klinik.local/fhir
EPA_BASE_URL=https://ti-gateway.klinik.local/fhir
TELEMATIK_ID=CHANGE_ME

# --- KIM client module ---
KIM_SMTP_HOST=kim-cm.klinik.local
KIM_SMTP_PORT=587
KIM_SENDER=intake@klinik.kim.telematik
KIM_RECIPIENT=CHANGE_ME@praxis.kim.telematik

# --- LLM (local, on-premise) ---
LLM_BASE_URL=http://llm:11434
LLM_MODEL=llama3.2:3b

# --- Backend protection ---
CORS_ORIGINS=https://intake.klinik.local
# Staging only (compose.staging.yml): address the browser uses for the VM, e.g. 192.168.8.165
# STAGING_HOST=192.168.8.165
SESSION_TTL_S=3600
CONSENT_TTL_S=3600
RATE_LIMIT_PER_MIN=30
AUDIT_LOG_FILE=

# --- Compose-level (read from the shell by deploy.sh) ---
# REGISTRY=registry.klinik.local/intake
# TLS_DIR=/etc/intake/tls
# SMCB_CERT_DIR=/etc/intake/smcb
# BACKUP_DIR=/var/backups/intake
